database module Chat exposing
    ( ConversationPageFlag(..)
    , Message
    , endpoint completeGenerationGoal
    , endpoint createGenerationGoal
    , endpoint expireGeneration
    , endpoint failGeneration
    , endpoint finishGeneration
    , endpoint getConversationDetailsFlags
    , endpoint getConversationPageFlags
    , endpoint getMessages
    , endpoint requestTurn
    , endpoint saveGenerationMemory
    , endpoint sendMessage
    , endpoint stopConversation
    )

import Conversation exposing (Conversation)
import ConversationId exposing (ConversationId)
import Cookies exposing (Cookies)
import Generation exposing (Generation)
import GenerationError exposing (GenerationError(..))
import GenerationId exposing (GenerationId)
import Goal
import GoalDescription exposing (GoalDescription)
import GoalId exposing (GoalId)
import IntervalSeconds exposing (IntervalSeconds(..))
import LocalAccount
import Memory
import MemoryContent exposing (MemoryContent)
import MemoryId exposing (MemoryId)
import MemoryKeywords exposing (MemoryKeywords(..))
import MessageContent exposing (MessageContent(..))
import MessageId exposing (MessageId)
import Origin
import Person exposing (Person)
import PersonId exposing (PersonId)
import PromptSnapshot exposing (PromptSnapshot(..))
import Revision exposing (Revision(..))
import Rows as R exposing (Rows)
import Security
import Sequence as Seq exposing (Sequence)
import Store
import Table exposing (Table)
import Time exposing (Posix)
import TurnCount exposing (TurnCount(..))


type alias Message =
    { id : MessageId
    , conversationId : ConversationId
    , author : PersonId
    , content : MessageContent
    }


messages : Table Security.Unrestricted Message
messages :=
    Table.table
        { primary = .id
        , security = Security.unrestricted
        , indexes = [ Table.btree Table.NotUnique .conversationId ]
        , constraints = [ Table.foreignKey .conversationId (Table.references Conversation.conversations .id) ]
        }


messageIds : Sequence MessageId
messageIds :=
    Seq.uint64 MessageId.fromUInt64


getMessages : Cookies -> ConversationId -> Transaction (Rows Message)
getMessages _ conversationId =
    Table.access messages Security.Unrestricted
        |> R.filter (\row -> row.conversationId == conversationId)
        |> R.selectAll



-- Keep unions left-associated with a single table on the right. Acadia 0.3.0
-- misdetects presence for a nested right-hand union. Apply scope filters only
-- after combining rows, otherwise they become unconditional WHERE clauses.
-- Include a real row key as well as the disjoint side tag: constant-only keys
-- let this compiler incorrectly simplify the result to the first flag kind.


type ConversationPageFlag
    = ConversationFlag Conversation
    | CurrentPersonFlag PersonId
    | PersonFlag Person
    | MessageFlag Message
    | ParticipantFlag PersonId
    | GenerationFlag Generation.GenerationSummary


type alias ScopedPageFlag =
    { key : UInt64
    , conversationId : Maybe ConversationId
    , flag : ConversationPageFlag
    }


getConversationDetailsFlags :
    Cookies
    -> ConversationId
    -> Transaction (Rows ConversationPageFlag)
getConversationDetailsFlags cookies conversationId =
    let
        currentPerson : PersonId
        currentPerson :=
            LocalAccount.currentPerson cookies
    in
    conversationDetailsRows
        |> selectPageFlags conversationId


getConversationPageFlags : Cookies -> ConversationId -> Transaction (Rows ConversationPageFlag)
getConversationPageFlags cookies conversationId =
    let
        currentPerson : PersonId
        currentPerson :=
            LocalAccount.currentPerson cookies
    in
    combinePageRows conversationDetailsRows
        (Table.access Conversation.conversations Security.Unrestricted
            |> R.map
                (\row ->
                    ScopedPageFlag (ConversationId.toUInt64 row.id)
                        (Just row.id)
                        (ConversationFlag row)
                )
        )
        |> selectPageFlags conversationId


conversationDetailsRows : Rows ScopedPageFlag
conversationDetailsRows =
    let
        peopleAndMessages : Rows ScopedPageFlag
        peopleAndMessages =
            combinePageRows
                (Person.allPersons
                    |> R.map
                        (\row ->
                            ScopedPageFlag (PersonId.toUInt64 row.id)
                                Nothing
                                (PersonFlag row)
                        )
                )
                (Table.access messages Security.Unrestricted
                    |> R.map
                        (\row ->
                            ScopedPageFlag (MessageId.toUInt64 row.id)
                                (Just row.conversationId)
                                (MessageFlag row)
                        )
                )

        withParticipants : Rows ScopedPageFlag
        withParticipants =
            combinePageRows peopleAndMessages
                (Table.access Conversation.participants Security.Unrestricted
                    |> R.map
                        (\row ->
                            ScopedPageFlag (PersonId.toUInt64 row.personId)
                                (Just row.conversationId)
                                (ParticipantFlag row.personId)
                        )
                )
    in
    combinePageRows
        (combinePageRows withParticipants
            (Table.access LocalAccount.accounts Security.Unrestricted
                |> R.map
                    (\row ->
                        ScopedPageFlag (PersonId.toUInt64 row.personId)
                            Nothing
                            (CurrentPersonFlag row.personId)
                    )
            )
        )
        (Table.access Generation.generations Security.Unrestricted
            |> R.map
                (\row ->
                    ScopedPageFlag (GenerationId.toUInt64 row.id)
                        (Just row.conversationId)
                        (GenerationFlag (Generation.toSummary row))
                )
        )


selectPageFlags :
    ConversationId
    -> Rows ScopedPageFlag
    -> Transaction (Rows ConversationPageFlag)
selectPageFlags conversationId rows =
    rows
        |> R.filter
            (\row ->
                (row.conversationId == Nothing)
                    || (row.conversationId == Just conversationId)
            )
        |> R.map .flag
        |> R.selectAll


combinePageRows : Rows ScopedPageFlag -> Rows ScopedPageFlag -> Rows ScopedPageFlag
combinePageRows left right =
    R.union (\row -> ( False, row.key ))
        left
        (\row -> ( True, row.key ))
        right
        |> R.map unionPageFlag


unionPageFlag : R.Union ScopedPageFlag ScopedPageFlag -> ScopedPageFlag
unionPageFlag row =
    case row of
        R.Left flag ->
            flag

        R.Right flag ->
            flag

        -- Side tags make this unreachable. Keep union: Acadia 0.3.0 xunion
        -- drops person-only results in the nested query (integration-tested).
        R.Both flag _ ->
            flag


-- Posting never claims an AI turn or requires an idle conversation.
-- Resolve the author on the server; the client cannot choose whom to impersonate.


sendMessage : Cookies -> ConversationId -> MessageContent -> Transaction ()
sendMessage cookies conversationId (MessageContent content) =
    if content == "" then
        Transaction.fail

    else
        let
            () :=
                Store.ensure Conversation.conversations (\row -> row.id == conversationId)

            author : PersonId
            author :=
                LocalAccount.currentPerson cookies

            () :=
                Store.ensure Conversation.participants
                    (\row -> row.conversationId == conversationId && row.personId == author)

            id : MessageId
            id :=
                Seq.next messageIds
        in
        Table.insert messages Security.Unrestricted
            { id = id
            , conversationId = conversationId
            , author = author
            , content = MessageContent content
            }


requestTurn :
    Cookies
    -> ConversationId
    -> Revision
    -> PersonId
    -> Transaction GenerationId
requestTurn _ conversationId expectedRevision speaker =
    let
        now : Posix
        now :=
            Time.now

        id : GenerationId
        id :=
            Seq.next Generation.generationIds

        () :=
            Person.requireAiPerson speaker

        () :=
            Store.ensure Conversation.participants
                (\row -> row.conversationId == conversationId && row.personId == speaker)

        () :=
            Store.update Conversation.conversations
                (\row -> row.id == conversationId && row.revision == expectedRevision && Conversation.isIdle row)
                (\row ->
                    { row
                        | activeGeneration = Just id
                        , revision = Revision.nextRevision row.revision
                        , nextTurnAt = Time.plus (IntervalSeconds.intervalValue row.intervalSeconds) Time.Seconds now
                        , remainingTurns = TurnCount.decrementTurns row.remainingTurns
                    }
                )

        () :=
            Table.insert Generation.generations
                Security.Unrestricted
                { id = id
                , conversationId = conversationId
                , speaker = speaker
                , phase = Generation.Pending
                , prompt = PromptSnapshot ""
                , error = GenerationError ""
                , leaseUntil = now
                }
    in
    Transaction.succeed id


finishGeneration :
    Cookies
    -> GenerationId
    -> MessageContent
    -> Transaction ()
finishGeneration _ id content =
    let
        now : Posix
        now :=
            Time.now

        generation : Generation
        generation :=
            Store.require Generation.generations
                (\row -> row.id == id && row.phase == Generation.Running && row.leaseUntil > now)

        messageId : MessageId
        messageId :=
            Seq.next messageIds

        () :=
            Store.update Conversation.conversations
                (\row -> row.id == generation.conversationId && Conversation.hasGeneration id row)
                (\row ->
                    { row
                        | activeGeneration = Nothing
                        , lastSpeaker = Just generation.speaker
                        , revision = Revision.nextRevision row.revision
                    }
                )

        () :=
            Table.insert messages
                Security.Unrestricted
                { id = messageId
                , conversationId = generation.conversationId
                , author = generation.speaker
                , content = content
                }
    in
    Store.update Generation.generations
        (\row -> row.id == id)
        (\row -> { row | phase = Generation.Completed })


failGeneration : Cookies -> GenerationId -> GenerationError -> Transaction ()
failGeneration _ id error =
    let
        generation : Generation
        generation :=
            Store.require Generation.generations
                (\row -> row.id == id && (row.phase == Generation.Running || row.phase == Generation.Pending))

        () :=
            Store.update Conversation.conversations
                (\row -> row.id == generation.conversationId && Conversation.hasGeneration id row)
                (\row ->
                    { row
                        | activeGeneration = Nothing
                        , remainingTurns = TurnCount 0
                        , autonomous = False
                        , revision = Revision.nextRevision row.revision
                    }
                )
    in
    Store.update Generation.generations
        (\row -> row.id == id)
        (\row -> { row | phase = Generation.Failed, error = error })


stopConversation : Cookies -> ConversationId -> Transaction ()
stopConversation _ conversationId =
    let
        conversation : Conversation
        conversation :=
            Store.require Conversation.conversations
                (\row -> row.id == conversationId)

        () :=
            case conversation.activeGeneration of
                Nothing ->
                    Transaction.succeed ()

                Just generationId ->
                    Store.update Generation.generations
                        (\row -> row.id == generationId)
                        (\row -> { row | phase = Generation.Cancelled })
    in
    Store.update Conversation.conversations
        (\row -> row.id == conversationId)
        (\row ->
            { row
                | activeGeneration = Nothing
                , remainingTurns = TurnCount 0
                , autonomous = False
                , revision = Revision.nextRevision row.revision
            }
        )


expireGeneration : Cookies -> GenerationId -> Transaction ()
expireGeneration cookies id =
    let
        now : Posix
        now :=
            Time.now

        () :=
            Store.ensure Generation.generations
                (\row ->
                    row.id
                        == id
                        && row.phase
                        == Generation.Running
                        && row.leaseUntil
                        <= now
                )
    in
    failGeneration cookies
        id
        (GenerationError
            "The worker did not finish before its deadline. No final reply was saved. Earlier tool actions may remain saved; inspect the turn before retrying."
        )


-- Every action resolves its owner from a live generation inside the same
-- transaction as the write. Cancellation and expired leases reject later actions.


requireRunningGeneration : GenerationId -> Transaction Generation
requireRunningGeneration id =
    let
        now : Posix
        now :=
            Time.now

        generation : Generation
        generation :=
            Store.require Generation.generations
                (\row -> row.id == id && row.phase == Generation.Running && row.leaseUntil > now)

        () :=
            Store.ensure Conversation.conversations
                (\row -> row.id == generation.conversationId && Conversation.hasGeneration id row)

        () :=
            Person.requireAiPerson generation.speaker
    in
    Transaction.succeed generation


createGenerationGoal : Cookies -> GenerationId -> GoalDescription -> Transaction GoalId
createGenerationGoal _ id description =
    let
        generation : Generation
        generation :=
            requireRunningGeneration id
    in
    Goal.insertGoalWithId generation.speaker description (Origin.Reflection id)


completeGenerationGoal : Cookies -> GenerationId -> GoalId -> Transaction ()
completeGenerationGoal _ id goalId =
    let
        generation : Generation
        generation :=
            requireRunningGeneration id
    in
    Goal.completeGoal generation.speaker goalId


saveGenerationMemory : Cookies -> GenerationId -> MemoryContent -> Transaction MemoryId
saveGenerationMemory _ id content =
    let
        generation : Generation
        generation :=
            requireRunningGeneration id
    in
    Memory.insertMemoryWithId generation.speaker content (MemoryKeywords "") (Origin.Reflection id)
