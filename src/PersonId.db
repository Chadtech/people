database module PersonId exposing
    ( PersonId
      --    , fromString
    , fromUInt64
      --    , toString
    , toUInt64
    )


type PersonId
    = PersonId UInt64


fromUInt64 : UInt64 -> PersonId
fromUInt64 n =
    PersonId n


toUInt64 : PersonId -> UInt64
toUInt64 (PersonId value) =
    value
