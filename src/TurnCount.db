database module TurnCount exposing (TurnCount(..), decrementTurns, hasTurns)


type TurnCount
    = TurnCount UInt8


decrementTurns : TurnCount -> TurnCount
decrementTurns (TurnCount value) =
    TurnCount
        (if value > 0 then
            value - 1

         else
            0
        )


hasTurns : TurnCount -> Bool
hasTurns (TurnCount value) =
    value > 0
