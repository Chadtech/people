database module Snapshot exposing (Snapshot, Source, Sources(..))


import CognitiveTrace exposing (CognitiveTrace)


type alias Source =
    { source : String
    , selectionReason : String
    , text : String
    }


type Sources
    = NoSources
    | SourceItem Source Sources


type alias Snapshot =
    { included : Sources
    , omitted : Sources
    , budget : UInt64
    , instructions : Maybe String
    , raw : String
    , cognition : Maybe CognitiveTrace
    }
