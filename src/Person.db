database module Person exposing
    ( Kind(..)
    , Person
    , PersonPageFlags
    , allPersons
    , createHumanPerson
    , requireAiPerson
    , requirePerson
    , endpoint createNewPerson
    , endpoint getAllPersons
    , endpoint loadPersonPage
    , endpoint updateHumanPersonName
    , endpoint updatePersonIdentity
    )

import AiPersonProfile exposing (AiPersonProfile)
import Cookies exposing (Cookies)
import PersonId exposing (PersonId)
import Revision exposing (Revision(..))
import Rows as R exposing (Rows)
import Security
import Sequence as Seq exposing (Sequence)
import Store
import Table exposing (Table)


type Kind
    = HumanPerson
    | AiPerson AiPersonProfile


type alias Person =
    { id : PersonId
    , kind : Kind
    , name : String
    , revision : Revision
    }


type alias PersonPageFlags =
    { person : Person
    }


people : Table Security.Unrestricted Person
people :=
    Table.table
        { primary = .id
        , security = Security.unrestricted
        , indexes = []
        , constraints = []
        }


personIds : Sequence PersonId
personIds :=
    Seq.uint64 PersonId.fromUInt64


createNewPerson : Cookies -> String -> Transaction PersonId
createNewPerson _ name =
    createPerson (AiPerson { identity = "", aspirations = "" }) name


createHumanPerson : String -> Transaction PersonId
createHumanPerson name =
    createPerson HumanPerson name


createPerson : Kind -> String -> Transaction PersonId
createPerson kind name =
    if name == "" then
        Transaction.fail

    else
        let
            id : PersonId
            id :=
                Seq.next personIds

            () :=
                Table.insert people
                    Security.Unrestricted
                    { id = id
                    , kind = kind
                    , name = name
                    , revision = Revision 0
                    }
        in
        Transaction.succeed id


updateHumanPersonName : Cookies -> PersonId -> Revision -> String -> Transaction PersonPageFlags
updateHumanPersonName _ personId expectedRevision name =
    let
        person : Person
        person :=
            requirePerson personId
    in
    case person.kind of
        HumanPerson ->
            if name == "" then
                Transaction.fail

            else
                let
                    () :=
                        Store.update people
                            (\row -> row.id == personId && row.revision == expectedRevision)
                            (\row ->
                                { row
                                    | name = name
                                    , revision = Revision.nextRevision row.revision
                                }
                            )

                    savedPerson : Person
                    savedPerson :=
                        requirePerson personId
                in
                Transaction.succeed { person = savedPerson }

        AiPerson _ ->
            Transaction.fail


updatePersonIdentity :
    Cookies
    -> PersonId
    -> Revision
    -> String
    -> String
    -> Transaction PersonPageFlags
updatePersonIdentity _ personId expectedRevision identity aspirations =
    let
        () :=
            requireAiPerson personId

        () :=
            Store.update people
                (\person -> person.id == personId && person.revision == expectedRevision)
                (\person ->
                    { person
                        | kind = AiPerson { identity = identity, aspirations = aspirations }
                        , revision = Revision.nextRevision person.revision
                    }
                )

        savedPerson : Person
        savedPerson :=
            Store.require people
                (\row -> row.id == personId)
    in
    Transaction.succeed { person = savedPerson }


loadPersonPage : Cookies -> PersonId -> Transaction (Maybe PersonPageFlags)
loadPersonPage _ personId =
    let
        maybePerson : Maybe Person
        maybePerson :=
            Table.access people Security.Unrestricted
                |> R.filter (\person -> person.id == personId)
                |> R.selectMaybe
    in
    maybePerson
        |> Maybe.map PersonPageFlags
        |> Transaction.succeed


getAllPersons : Cookies -> Transaction (Rows Person)
getAllPersons _ =
    allPersons
        |> R.selectAll


allPersons : Rows Person
allPersons =
    Table.access people Security.Unrestricted


requirePerson : PersonId -> Transaction Person
requirePerson personId =
    Store.require people
        (\person -> person.id == personId)


requireAiPerson : PersonId -> Transaction ()
requireAiPerson personId =
    let
        person : Person
        person :=
            requirePerson personId
    in
    case person.kind of
        AiPerson _ ->
            Transaction.succeed ()

        HumanPerson ->
            Transaction.fail
